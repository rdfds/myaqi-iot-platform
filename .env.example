POSTGRES_DB=myaqi
POSTGRES_USER=myaqi
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://myaqi:replace-with-a-local-password@localhost:5432/myaqi
# AWS tasks use DB_HOST/DB_NAME plus DB_USER/DB_PASSWORD from the RDS-managed secret.
DEVICE_MASTER_KEY=replace-with-at-least-32-random-characters
AUTH_CLOCK_SKEW_SECONDS=300
MAX_BATCH_SIZE=500
LOG_LEVEL=INFO
APP_ENVIRONMENT=development
SERVICE_VERSION=0.1.0-dev
APP_REVISION=local
OUTBOX_HEALTH_INTERVAL_SECONDS=60
OUTBOX_SNS_TOPIC_ARN=
